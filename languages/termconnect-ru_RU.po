msgid "CSS class"
msgstr "CSS-класс"

#: blocks/peer-posts/src/index.js:58
msgid "— All enabled taxonomies —"
msgstr "— Все включённые таксономии —"

#: blocks/peer-posts/src/index.js:75
msgid ""
"Select which peers to query. Leave all unchecked to use every configured "
"peer."
msgstr ""
"Выберите, какие сторонние сайты запрашивать. Оставьте все флажки снятыми, "
"чтобы использовать все настроенные сторонние сайты."

#: blocks/peer-posts/src/index.js:81
msgid "Restrict to one taxonomy. Leave empty to use all."
msgstr "Ограничить одной таксономией. Оставьте пустым, чтобы использовать все."

#: blocks/peer-posts/src/index.js:94
msgid "Match mode"
msgstr "Режим совпадения"

#: blocks/peer-posts/src/index.js:96
msgid ""
"Any: return posts matching at least one term. All: posts must match all "
"primary terms."
msgstr ""
"Любые: возвращаются записи, совпадающие хотя бы с одним термином. Все: "
"записи должны совпадать со всеми основными терминами."

#: blocks/peer-posts/src/index.js:109
msgid ""
"Peers only, or blend in this site’s own matching posts (local relevance-"
"ranked via HyperTaxonomy when active)."
msgstr ""
"Показывать только записи со сторонних сайтов или добавить собственные "
"подходящие записи этого сайта (локально ранжированные по релевантности через "
"HyperTaxonomy, когда он активен)."

#: blocks/peer-posts/src/index.js:120
msgid "Order by"
msgstr "Критерии сортировки"

#: blocks/peer-posts/src/index.js:123
msgid "Score (relevance)"
msgstr "Оценка (релевантность)"

#: blocks/peer-posts/src/index.js:124
msgid "Group by peer, then relevance"
msgstr "Сторонний сайт, затем релевантность"

#: blocks/peer-posts/src/index.js:125
msgid "Date published (newest first)"
msgstr "Дата публикации (сначала новые)"

#: blocks/peer-posts/src/index.js:126
msgid "Modified date"
msgstr "Дата изменения"

#: blocks/peer-posts/src/index.js:127
msgid "Title (A–Z)"
msgstr "Заголовок (А–Я)"

#: blocks/peer-posts/src/index.js:128
msgid "Relevance (post title search)"
msgstr "Релевантность (поиск по заголовку записи)"

#: blocks/peer-posts/src/index.js:133
msgid "Results per page"
msgstr "Количество результатов на странице"

#: blocks/peer-posts/src/index.js:141
msgid "Max results (0 = use default)"
msgstr "Максимальное количество результатов (0 = по умолчанию)"

#: blocks/peer-posts/src/index.js:143
msgid ""
"Total pages to fetch and cache (fetch size = max pages × per page). Extra "
"pages are served via load-more without a new request to the peer site."
msgstr ""
"Общее число страниц для получения и кэширования (размер выборки = макс. "
"страниц × число записей на странице). Дополнительные страницы отображаются "
"без нового запроса к стороннему сайту."

#: blocks/peer-posts/src/index.js:156
msgid "Peer Network"
msgstr "Сеть сторонних сайтов"

#: blocks/peer-posts/src/index.js:160
msgid "FOAF depth"
msgstr "Глубина FOAF"

#: blocks/peer-posts/src/index.js:162
msgid ""
"Follow peer connections discovered from post responses. 0 = disabled. Capped "
"at the global Max FOAF Depth setting."
msgstr ""
"Следовать по цепочке новых сторонних сайтов, обнаруженных через записи, "
"найденные на настроенных сторонних сайтах. 0 = отключено. Ограничено общей "
"настройкой «Максимальная глубина FOAF»."

#: blocks/peer-posts/src/index.js:172
msgid "Require HyperTaxonomy peers only"
msgstr "Только сторонние сайты с HyperTaxonomy"

#: blocks/peer-posts/src/index.js:174
msgid ""
"Skip standard WordPress peers. Only query sites running HyperTaxonomy, which "
"provide server-side relevance scoring."
msgstr ""
"Пропускать сайты, где плагин HyperTaxonomy не установлен. Запрашивать только "
"сайты с HyperTaxonomy, которые вычисляют оценку релевантности и включают её "
"в результаты запроса."

#: blocks/peer-posts/src/index.js:181
msgid "Include local synonyms"
msgstr "Включать локальные синонимы"

#: blocks/peer-posts/src/index.js:183
msgid ""
"Resolve local synonym terms to their remote equivalents and send them as "
"additional primary terms. Synonyms receive the same direct-match score as "
"the primary queried term."
msgstr ""
"Вычислять удалённые эквиваленты синонимов локальных терминов и отправлять их "
"в дополнение к основным терминам. Синонимы получают ту же оценку при прямом "
"совпадении, что и основной запрашиваемый термин."

#: blocks/peer-posts/src/index.js:190
msgid "Include related terms"
msgstr "Включать связанные термины"

#: blocks/peer-posts/src/index.js:192
msgid ""
"Resolve locally included (non-synonym) terms to their remote equivalents and "
"send them alongside the primary terms. Matched at a lower weight than direct "
"or synonym matches."
msgstr ""
"Вычислять удалённые эквиваленты включённых локальных терминов (не-синонимов) "
"и отправлять их в дополнение к основным терминам. Сопоставляются с меньшим "
"значением коэффициента, чем прямые совпадения или синонимы."

#: blocks/peer-posts/src/index.js:201
msgid ""
"When on, each peer also matches the queried terms through its own "
"relationship graph (not just direct assignments), surfacing more of its "
"content. Off by default for predictable results."
msgstr ""
"Когда включено, каждый сторонний сайт также сопоставляет запрашиваемые "
"термины через свой собственный граф связей (а не только прямые связи), что "
"может привести к обнаружению большего количества результатов и влиять на их "
"порядок. По умолчанию отключено для лучшей предсказуемости."

#: blocks/peer-posts/src/index.js:233
msgid "Registered image size; sets the uniform thumbnail aspect."
msgstr ""
"Зарегистрированный размер изображения; задаёт единое соотношение сторон "
"миниатюры."

#: blocks/peer-posts/src/index.js:241
msgid "Cards (div)"
msgstr "Карточки (div)"

#: blocks/peer-posts/src/index.js:242
msgid "Bulleted list (ul)"
msgstr "Маркированный список (ul)"

#: blocks/peer-posts/src/index.js:243
msgid "Numbered list (ol)"
msgstr "Нумерованный список (ol)"

#: blocks/peer-posts/src/index.js:248
msgid "Template (style variant)"
msgstr "Шаблон (вариант стиля)"

#: blocks/peer-posts/src/index.js:249
msgid "CSS class suffix added as tc-result-{template}."
msgstr "Суффикс CSS-класса, добавляемый как tc-result-{template}."

#: blocks/peer-posts/src/index.js:254
msgid "Meta line"
msgstr "Строка метаданных"

#: blocks/peer-posts/src/index.js:256
msgid ""
"Template for the meta line below each title. Tokens: {date}, {label}, "
"{hostname}, {origin}. Leave empty to hide."
msgstr ""
"Шаблон строки метаданных под каждым заголовком. Переменные: {date}, {label}, "
"{hostname}, {origin}. Оставьте пустым, чтобы скрыть."

#: blocks/peer-posts/src/index.js:263
msgid "Prepend HTML (per item)"
msgstr "HTML в начале (для каждого элемента)"

#: blocks/peer-posts/src/index.js:265
msgid ""
"HTML inserted before each result item. Tokens: {title}, {url}, {date}, "
"{excerpt}, {label}, {hostname}, {origin}."
msgstr ""
"HTML, вставляемый перед каждым элементом результата. Переменные: {title}, "
"{url}, {date}, {excerpt}, {label}, {hostname}, {origin}."

#: blocks/peer-posts/src/index.js:272
msgid "Append HTML (per item)"
msgstr "HTML в конце (для каждого элемента)"

#: blocks/peer-posts/src/index.js:274
msgid "HTML inserted after each result item. Same tokens as prepend."
msgstr ""
"HTML, вставляемый после каждого элемента результата. Те же переменные, что и "
"в начале."

#: blocks/peer-posts/src/index.js:282
msgid "Shown when no peer posts are found. Leave empty to render nothing."
msgstr ""
"Показывается, когда записи со сторонних сайтов не найдены. Оставьте пустым, "
"чтобы ничего не отображать."

#: blocks/peer-posts/src/index.js:287
msgid "Additional CSS class"
msgstr "Дополнительный CSS-класс"

#: blocks/peer-posts/src/index.js:299
msgid "Cache TTL (seconds)"
msgstr "TTL кэширования (в секундах)"

#: blocks/peer-posts/src/index.js:301
msgid ""
"Leave empty to use the global External Posts Cache TTL from Settings → "
"External Posts."
msgstr ""
"Оставьте пустым, чтобы использовать общий TTL кэширования внешних записей из "
"раздела «Настройки → Внешние записи»."

